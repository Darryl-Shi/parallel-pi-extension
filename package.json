{
  "name": "parallel-pi-extension",
  "version": "1.2.0-fast.1",
  "description": "Standalone Parallel web search/fetch extension for Pi, defaulting to Fast search mode",
  "author": "Parallel Web; standalone patch by Darryl-Shi",
  "license": "MIT",
  "type": "module",
  "pi": {
    "image": "https://assets.parallel.ai/white-parallel-avatar-540.png",
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "parallel-web": "1.3.0",
    "typebox": "^1.1.37"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "pi-package",
    "pi.dev",
    "pi agent",
    "extension",
    "parallel",
    "web",
    "search",
    "fetch",
    "fast"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darryl-Shi/parallel-pi-extension.git"
  },
  "private": true
}
